{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vakwen.local/schemas/kzo-244-acceptance-matrix.schema.json",
  "title": "KZO-244 Taiwan Stock Research V1 Acceptance Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "matrixVersion",
    "ticket",
    "title",
    "selectionVerifiedAt",
    "authoritativeCorpus",
    "gates",
    "baselineCutoffPolicy",
    "fixturePolicy",
    "referenceSubjects",
    "cases",
    "approvals",
    "handoffChecklist"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "matrixVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "ticket": { "const": "KZO-244" },
    "title": { "type": "string", "minLength": 1 },
    "selectionVerifiedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "authoritativeCorpus": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/definitions/corpusEntry" }
    },
    "gates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/definitions/gate" }
    },
    "baselineCutoffPolicy": { "type": "string", "minLength": 1 },
    "fixturePolicy": { "$ref": "#/definitions/fixturePolicy" },
    "referenceSubjects": {
      "type": "array",
      "minItems": 9,
      "items": { "$ref": "#/definitions/referenceSubject" }
    },
    "cases": {
      "type": "array",
      "minItems": 40,
      "items": { "$ref": "#/definitions/acceptanceCase" }
    },
    "approvals": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/definitions/approval" }
    },
    "handoffChecklist": {
      "type": "array",
      "minItems": 10,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "definitions": {
    "corpusEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "locator", "authority"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["linear_issue", "linear_resolution", "repository_artifact"] },
        "locator": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "authority": { "type": "string", "minLength": 1 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "purpose", "completionRule"],
      "properties": {
        "id": { "enum": ["G1", "G2", "G3"] },
        "name": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "completionRule": { "type": "string", "minLength": 1 }
      }
    },
    "fixturePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredMetadata", "mutationRule", "privateDataRule", "redistributionRule"],
      "properties": {
        "requiredMetadata": {
          "type": "array",
          "minItems": 10,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "mutationRule": { "type": "string", "minLength": 1 },
        "privateDataRule": { "type": "string", "minLength": 1 },
        "redistributionRule": { "type": "string", "minLength": 1 }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticker", "venue", "name", "instrumentType"],
      "properties": {
        "ticker": { "type": "string", "minLength": 4 },
        "venue": { "enum": ["TWSE", "TPEX"] },
        "name": { "type": "string", "minLength": 1 },
        "instrumentType": { "enum": ["common_equity", "etf", "etn"] },
        "notes": { "type": "string" }
      }
    },
    "referenceSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "primary", "fallback", "uniqueCoverage", "validationPolicy"],
      "properties": {
        "role": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
        "primary": { "$ref": "#/definitions/selector" },
        "fallback": { "$ref": "#/definitions/selector" },
        "uniqueCoverage": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "validationPolicy": { "type": "string", "minLength": 1 }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "operations"],
      "properties": {
        "base": { "type": "string", "minLength": 1 },
        "operations": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "assertions"],
      "properties": {
        "kind": { "enum": ["exact", "semantic", "mixed", "statistical", "human"] },
        "assertions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "commandFamily", "backends"],
      "properties": {
        "layer": {
          "enum": [
            "specification",
            "unit_schema",
            "memory_integration",
            "postgres_integration",
            "oauth_http",
            "skill_report",
            "deployed_dev",
            "rollout_observation"
          ]
        },
        "commandFamily": { "type": "string", "minLength": 1 },
        "backends": {
          "type": "array",
          "items": { "enum": ["none", "memory", "postgres_redis", "deployed_dev", "production"] },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "acceptanceCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "gate",
        "title",
        "sourceDecisions",
        "referenceRole",
        "profile",
        "cutoffPolicy",
        "purpose",
        "preconditions",
        "path",
        "expected",
        "requiredLineage",
        "prohibited",
        "oracle",
        "harness",
        "ownerRole",
        "reviewerRoles",
        "waiverClass",
        "variants"
      ],
      "properties": {
        "caseId": { "type": "string", "pattern": "^(SPEC|DATA|MCP|REPORT|VAL|PORT|COMPAT|SEC|OPS)-[0-9]{3}$" },
        "gate": { "enum": ["G1", "G2", "G3"] },
        "title": { "type": "string", "minLength": 1 },
        "sourceDecisions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^KZO-2(3[4-9]|4[0-4])(?::.+)?$" }
        },
        "referenceRole": { "type": "string", "minLength": 1 },
        "profile": { "enum": ["any", "operating_company", "etf_limited", "identity_only"] },
        "cutoffPolicy": { "type": "string", "minLength": 1 },
        "purpose": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "preconditions": { "type": "array", "items": { "type": "string" } },
        "mutation": { "$ref": "#/definitions/mutation" },
        "path": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "expected": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "requiredLineage": { "type": "array", "items": { "type": "string" } },
        "prohibited": { "type": "array", "items": { "type": "string" } },
        "oracle": { "$ref": "#/definitions/oracle" },
        "harness": { "$ref": "#/definitions/harness" },
        "ownerRole": { "type": "string", "minLength": 1 },
        "reviewerRoles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "waiverClass": { "enum": ["none", "optional_evidence", "noncritical_operational"] },
        "variants": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "requiredRoles", "independenceRule"],
      "properties": {
        "gate": { "enum": ["G1", "G2", "G3"] },
        "requiredRoles": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "independenceRule": { "type": "string", "minLength": 1 }
      }
    }
  }
}
